def extract_deterministic_prediction(
    output,
):
    if isinstance(
        output,
        torch.Tensor,
    ):
        candidate = output

    else:
        candidate = None

        for name in (
            "prediction",
            "mean",
            "trajectory",
            "positions",
        ):
            value = getattr(
                output,
                name,
                None,
            )

            if isinstance(
                value,
                torch.Tensor,
            ):
                candidate = value
                break

        if (
            candidate is None
            and
            isinstance(
                output,
                (
                    tuple,
                    list,
                ),
            )
            and
            output
            and
            isinstance(
                output[
                    0
                ],
                torch.Tensor,
            )
        ):
            candidate = output[
                0
            ]

    if candidate is None:
        raise RuntimeError(
            "Could not extract deterministic "
            "trajectory tensor from model output."
        )

    if (
        candidate.ndim != 3
        or
        tuple(
            candidate.shape[
                1:
            ]
        )
        !=
        (
            4,
            3,
        )
    ):
        raise RuntimeError(
            "Deterministic prediction shape "
            f"changed: {tuple(candidate.shape)}"
        )

    return candidate

