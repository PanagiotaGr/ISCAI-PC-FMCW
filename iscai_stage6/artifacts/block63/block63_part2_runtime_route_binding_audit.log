sha256 = c16df220da97cdf503df12973f56151046809f0bd358204fb29bdb820075a1fb
def prediction_sha256(
    mean,
    scale_tril,
):
    digest = sha256()

    for tensor in (
        mean,
        scale_tril,
    ):
        value = (
            tensor.detach()
            .cpu()
            .contiguous()
            .numpy()
            .astype(
                np.float32,
                copy=False,
            )
        )

        digest.update(
            value.tobytes(
                order="C"
            )
        )

    return digest.hexdigest()

