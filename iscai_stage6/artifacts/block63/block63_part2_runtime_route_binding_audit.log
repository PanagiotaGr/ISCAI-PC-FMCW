runtime.public_callables[13].source_preview = def prediction_sha256(
    mean,
    scale_tril,
):
    digest = sha256()

    for tensor in (
        mean,
        scale_tril,
    ):
        value = (
            tensor.detach()
            .cpu()
            .contiguous()
            .numpy()
            .astype(
                np.float32,
                copy=False,
            )
        )

        digest.update(
            value.tobytes(
                order="C"
            )
        )

    return digest.hexdigest()


