def map_component_index(
    mixture_logits: torch.Tensor,
) -> torch.Tensor:
    return torch.argmax(
        mixture_logits,
        dim=-1,
    )

/home/agni/waymo/iscai_stage4/src/iscai_stage4/ml/gmm_math.py:334 | map_component_mean
def map_component_mean(
    mixture_logits: torch.Tensor,
    means: torch.Tensor,
) -> torch.Tensor:
    if means.ndim != 4:
        raise ValueError(
            "means must be [B,K,H,3]."
        )

    index = map_component_index(
        mixture_logits
    )

    batch = torch.arange(
        means.shape[0],
        device=means.device,
    )

    return means[
        batch,
        index,
        :,
        :
    ]

/home/agni/waymo/iscai_stage4/src/iscai_stage4/training/preprocess.py:238 | normalize_map_context
def normalize_map_context(
    value: torch.Tensor,
    stats: NormalizationStats,
) -> torch.Tensor:
    mean = torch.tensor(
        stats.map_mean,
        dtype=value.dtype,
        device=value.device,
    )

    std = torch.tensor(
        stats.map_std,
        dtype=value.dtype,
        device=value.device,
    )

    return (
        value
        -
        mean
    ) / std

