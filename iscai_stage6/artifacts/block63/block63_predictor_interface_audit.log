===== G. STAGE6 FUTURE-BOX GEOMETRY API =====
Box3D signature = (center_xyz: 'tuple[float, float, float]', length_m: 'float', width_m: 'float', height_m: 'float', yaw_rad: 'float') -> None
Box3D fields = ['center_xyz', 'length_m', 'width_m', 'height_m', 'yaw_rad']
project_box_to_headlamp signature = (box: 'Box3D', *, state_source: 'str', orientation_source: 'str', controller_path: 'bool' = True) -> 'ProjectedBox'

project_box_to_headlamp source:
def project_box_to_headlamp(
    box: Box3D,
    *,
    state_source: str,
    orientation_source: str,
    controller_path: bool = True,
) -> ProjectedBox:
    """
    Full 3D actor-box projection.

    Centroid projection is retained only as diagnostic metadata;
    all extent fields are derived from all 8 physical corners.
    """

    validate_controller_provenance(
        state_source=state_source,
        orientation_source=orientation_source,
        controller_path=controller_path,
    )

    corners_xyz = box_corners_headlamp(
        box
    )

    corners = project_points_to_headlamp(
        corners_xyz
    )

    centroid = project_points_to_headlamp(
        box.center[
            None,
            :
        ]
    )

    (
        theta_center,
        theta_span,
        theta_min,
        theta_max,
    ) = _minimal_circular_interval(
        corners.theta_rad
    )

    return ProjectedBox(
        box=box,
        corners=corners,
        centroid=centroid,

        theta_center_rad=theta_center,
        theta_span_rad=theta_span,
        theta_min_unwrapped_rad=theta_min,
        theta_max_unwrapped_rad=theta_max,

        ground_range_min_m=float(
            np.min(
                corners.ground_range_m
            )
        ),

        ground_range_max_m=float(
            np.max(
                corners.ground_range_m
            )
        ),

        range_3d_min_m=float(
            np.min(
                corners.range_3d_m
            )
        ),

        range_3d_max_m=float(
            np.max(
                corners.range_3d_m
            )
        ),

        phi_min_rad=float(
            np.min(
                corners.phi_rad
            )
        ),

        phi_max_rad=float(
            np.max(
                corners.phi_rad
            )
        ),

        state_source=str(
            state_source
        ),

        orientation_source=str(
            orientation_source
        ),

        controller_path=bool(
            controller_path
        ),
    )


