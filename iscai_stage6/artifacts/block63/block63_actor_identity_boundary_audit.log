def _extract_prediction_id(
    associated_track,
) -> str:
    for name in (
        "track_id",
        "prediction_id",
        "associated_track_id",
    ):
        if hasattr(
            associated_track,
            name,
        ):
            value = getattr(
                associated_track,
                name,
            )

            if value is not None:
                value = str(value)

                if value:
                    return value

    raise RuntimeError(
        "Cannot resolve associated "
        "track identifier."
    )

===== B2. build_causal_track_history =====

