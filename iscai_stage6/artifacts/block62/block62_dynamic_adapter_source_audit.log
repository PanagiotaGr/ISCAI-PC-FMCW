def adb_trz_shadow_geometry_from_xy(x_track, y_track):
    """
    Dynamic ADB geometry from reconstructed x(t), y(t).

    Coordinate convention:
        ego at (0, 0)
        +y forward
        +x right
        theta = atan2(x, y), in degrees
    """
    return adb_shadow_geometry_from_xy(x_track, y_track, include_radial_zone=True)

