iscai_stage6.adb.womd_geometry.world_heading_to_headlamp_yaw
------------------------------------------------------------------------------
signature = (*, heading_W_rad: 'float', T_H0_from_W: 'Any') -> 'float'
def world_heading_to_headlamp_yaw(
    *,
    heading_W_rad: float,
    T_H0_from_W: Any,
) -> float:
    """
    Transform an actor's world-frame forward direction into H0
    and recover yaw from the projected horizontal direction.

    No future heading is used.
    """

    heading = float(
        heading_W_rad
    )

    if not math.isfinite(
        heading
    ):
        raise ValueError(
            "heading_W_rad must be finite"
        )

    forward_W = np.asarray(
        [
            math.cos(heading),
            math.sin(heading),
            0.0,
        ],
        dtype=np.float64,
    )

    forward_H0 = (
        _rotation_matrix(
            T_H0_from_W
        )
        @
        forward_W
    )

    horizontal_norm = math.hypot(
        float(
            forward_H0[0]
        ),
        float(
            forward_H0[1]
        ),
    )

    if horizontal_norm <= 1.0e-12:
        raise ValueError(
            "Transformed actor forward vector "
            "has zero horizontal norm"
        )

    return wrap_angle(
        math.atan2(
            float(
                forward_H0[1]
            ),
            float(
                forward_H0[0]
            ),
        )
    )


