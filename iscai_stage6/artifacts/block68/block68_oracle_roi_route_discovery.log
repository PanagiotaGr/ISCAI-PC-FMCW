  L0736: def estimate_actor_occupancy_probability(
  L0737:     forecast: StochasticFullBoxForecast,
  L0738:     grid: OccupancyGrid,
  L0739: ) -> ActorOccupancyProbability:
  L0740:     """
  L0741:     Monte-Carlo estimate of one actor's
  L0742: 
  L0743:         P_occ(theta, r, tau).
  L0744: 
  L0745:     For every sample and horizon, the indicator is obtained
  L0746:     from the convex hull of all eight physical projected box
  L0747:     corners.
  L0748: 
  L0749:     Probability is exactly:
  L0750:         occupancy_count / forecast.sample_count
  L0751: 
  L0752:     No gamma threshold is applied here.
  L0753:     """
  L0754: 
  L0755:     count = int(
  L0756:         forecast.sample_count
  L0757:     )
  L0758: 
  L0759:     if count <= 0:
  L0760:         raise ValueError(
  L0761:             "forecast.sample_count must be positive."
  L0762:         )
  L0763: 
  L0764:     if len(
  L0765:         forecast.future
  L0766:     ) != count:
  L0767:         raise ValueError(
  L0768:             "forecast.future/sample_count mismatch."
  L0769:         )
  L0770: 
  L0771:     theta_count, range_count = (
  L0772:         grid.shape
  L0773:     )
  L0774: 
  L0775:     occupancy_counts = np.zeros(
  L0776:         (
  L0777:             4,
  L0778:             theta_count,
  L0779:             range_count,
  L0780:         ),
  L0781:         dtype=np.uint32,
  L0782:     )
  L0783: 
  L0784:     for sample_index, sequence in enumerate(
  L0785:         forecast.future
  L0786:     ):
  L0787:         if len(
  L0788:             sequence
  L0789:         ) != 4:
  L0790:             raise ValueError(
  L0791:                 "Every trajectory sample must "
  L0792:                 "contain four future horizons."
  L0793:             )
  L0794: 
  L0795:         for horizon_index, item in enumerate(
  L0796:             sequence
  L0797:         ):
  L0798:             if int(
  L0799:                 item.sample_index
  L0800:             ) != sample_index:
  L0801:                 raise ValueError(
  L0802:                     "Forecast sample index mismatch."
  L0803:                 )
  L0804: 
  L0805:             if int(
  L0806:                 item.horizon_index
  L0807:             ) != horizon_index:
  L0808:                 raise ValueError(
  L0809:                     "Forecast horizon index mismatch."
  L0810:                 )
  L0811: 
  L0812:             mask = rasterize_projected_full_box(
  L0813:                 item,
  L0814:                 grid,
  L0815:             )
