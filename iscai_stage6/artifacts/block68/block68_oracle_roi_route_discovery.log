FUNCTION = box_intersects_forward_sector @L581
categories = {'future_full_box': 3, 'reactive_reference': 1}
arguments = ['box', 'half_angle_rad', 'maximum_range_m', 'box_corners_headlamp']
excerpt:
  L0581: def box_intersects_forward_sector(
  L0582:     box,
  L0583:     *,
  L0584:     half_angle_rad: float,
  L0585:     maximum_range_m: float,
  L0586:     box_corners_headlamp,
  L0587: ) -> bool:
  L0588:     """
  L0589:     Continuous intersection of the CURRENT full-box
  L0590:     ground footprint with:
  L0591: 
  L0592:         |theta| <= half_angle_rad
  L0593:         0 <= r <= maximum_range_m.
  L0594: 
  L0595:     Angular clipping is performed in Cartesian H0,
  L0596:     avoiding the +/-pi wrap ambiguity.
  L0597:     """
  L0598: 
  L0599:     corners = np.asarray(
  L0600:         box_corners_headlamp(
  L0601:             box
  L0602:         ),
  L0603:         dtype=np.float64,
  L0604:     )
  L0605: 
  L0606:     require(
  L0607:         corners.shape
  L0608:         ==
  L0609:         (
  L0610:             8,
  L0611:             3,
  L0612:         ),
  L0613:         (
  L0614:             "Expected exactly eight physical "
  L0615:             f"box corners; got {corners.shape}."
  L0616:         ),
  L0617:     )
  L0618: 
  L0619:     footprint = convex_hull_xy(
  L0620:         corners[:, :2]
  L0621:     )
  L0622: 
  L0623:     tangent = math.tan(
  L0624:         half_angle_rad
  L0625:     )
  L0626: 
  L0627:     # Upper ray:
  L0628:     # y <= x*tan(alpha)
  L0629:     clipped = clip_polygon_halfplane(
  L0630:         footprint,
  L0631:         a=-tangent,
  L0632:         b=1.0,
  L0633:     )
  L0634: 
  L0635:     if clipped.shape[0] == 0:
  L0636:         return False
  L0637: 
  L0638:     # Lower ray:
  L0639:     # y >= -x*tan(alpha)
  L0640:     # -y - x*tan(alpha) <= 0

