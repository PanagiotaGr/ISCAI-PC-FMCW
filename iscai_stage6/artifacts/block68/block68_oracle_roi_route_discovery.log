  L0185: def _projected_theta_range_points(
  L0186:     future_item,
  L0187: ) -> np.ndarray:
  L0188:     """
  L0189:     Use all eight physical projected box corners.
  L0190: 
  L0191:     Convert H0/headlamp XYZ corner locations to
  L0192:     (theta, ground-range) coordinates.
  L0193: 
  L0194:     No centroid surrogate is used.
  L0195:     """
  L0196: 
  L0197:     xyz = np.asarray(
  L0198:         future_item
  L0199:         .projection
  L0200:         .corners
  L0201:         .xyz,
  L0202:         dtype=np.float64,
  L0203:     )
  L0204: 
  L0205:     if xyz.shape != (
  L0206:         8,
  L0207:         3,
  L0208:     ):
  L0209:         raise ValueError(
  L0210:             "Every projected physical box must "
  L0211:             "contain exactly eight XYZ corners."
  L0212:         )
  L0213: 
  L0214:     if not np.all(
  L0215:         np.isfinite(
  L0216:             xyz
  L0217:         )
  L0218:     ):
  L0219:         raise ValueError(
  L0220:             "Projected corner XYZ must be finite."
  L0221:         )
  L0222: 
  L0223:     theta = np.arctan2(
  L0224:         xyz[
  L0225:             :,
  L0226:             1
  L0227:         ],
  L0228:         xyz[
  L0229:             :,
  L0230:             0
  L0231:         ],
  L0232:     )
  L0233: 
  L0234:     ground_range = np.hypot(
  L0235:         xyz[
  L0236:             :,
  L0237:             0
  L0238:         ],
  L0239:         xyz[
  L0240:             :,
  L0241:             1
  L0242:         ],
  L0243:     )
  L0244: 
  L0245:     result = np.column_stack(
  L0246:         (
  L0247:             theta,
  L0248:             ground_range,
  L0249:         )
  L0250:     )
  L0251: 
  L0252:     if not np.all(
  L0253:         np.isfinite(
  L0254:             result
  L0255:         )
  L0256:     ):
  L0257:         raise ValueError(
  L0258:             "Projected theta/r points must be finite."
  L0259:         )
  L0260: 
  L0261:     return result

