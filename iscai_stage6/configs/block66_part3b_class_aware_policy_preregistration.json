      "formula": "mean(I_final over frozen road ROI)"
    },
    "temporal_smoothness": {
      "direction": "lower_is_better",
      "formula": "mean_h(mean_grid(|I_h-I_prev|)/delta_t_h)",
      "reported_metric": "mean_absolute_change_rate"
