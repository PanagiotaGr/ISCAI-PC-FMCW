# ============================================================
# Communication / DPSK receiver branch - Cell 2
# ============================================================

comm_tx_waveform = s_tx[comm_chirp_index]

comm_signal_power = np.mean(np.abs(comm_tx_waveform) ** 2)
comm_noise_power = comm_signal_power / (10.0 ** (comm_rx_snr_db / 10.0))

comm_rng = np.random.default_rng(comm_noise_seed)
comm_noise = np.sqrt(comm_noise_power / 2.0) * (
    comm_rng.standard_normal(comm_tx_waveform.shape)
    + 1j * comm_rng.standard_normal(comm_tx_waveform.shape)
)

comm_rx_waveform = comm_tx_waveform + comm_noise

print("Communication waveform")
print("----------------------")
print(f"SNR test condition : {comm_rx_snr_db:.1f} dB")
print(f"Signal power       : {comm_signal_power:.4e}")
print(f"Noise power        : {comm_noise_power:.4e}")

