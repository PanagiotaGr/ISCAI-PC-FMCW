------------------------------------------------------------
mahalanobis_squared (mean: 'torch.Tensor', scale_tril: 'torch.Tensor', target: 'torch.Tensor') -> 'torch.Tensor'
------------------------------------------------------------
def mahalanobis_squared(
    mean: torch.Tensor,
    scale_tril: torch.Tensor,
    target: torch.Tensor,
) -> torch.Tensor:
    if mean.shape != target.shape:
        raise ValueError(
            "Mean/target shape mismatch."
        )

    if scale_tril.shape != (
        mean.shape[0],
        mean.shape[1],
        POSITION_DIM,
        POSITION_DIM,
    ):
        raise ValueError(
            "scale_tril shape mismatch."
        )

    residual = (
        target
        -
        mean
    )

    solved = (
        torch.linalg
        .solve_triangular(
            scale_tril,
            residual.unsqueeze(
                -1
            ),
            upper=False,
        )
        .squeeze(
            -1
        )
    )

    return (
        solved
        .square()
        .sum(
            dim=-1
        )
    )


