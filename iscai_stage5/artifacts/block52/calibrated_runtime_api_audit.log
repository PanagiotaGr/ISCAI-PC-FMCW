------------------------------------------------------------
def build_gaussian_model(
    configuration,
    *,
    device,
):
    model_config = (
        configuration[
            "model"
        ]
    )

    return GaussianTrajectoryGRU(
        target_hidden_dim=int(
            model_config[
                "target_hidden_dim"
            ]
        ),
        neighbor_hidden_dim=int(
            model_config[
                "neighbor_hidden_dim"
            ]
        ),
        map_hidden_dim=int(
            model_config[
                "map_hidden_dim"
            ]
        ),
        fusion_hidden_dim=int(
            model_config[
                "fusion_hidden_dim"
            ]
        ),
        use_neighbors=True,
        use_map=True,
    ).to(device)


