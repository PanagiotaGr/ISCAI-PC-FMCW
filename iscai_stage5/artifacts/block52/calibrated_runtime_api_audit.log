def covariance_from_scale_tril(
    scale_tril: torch.Tensor,
) -> torch.Tensor:
    if scale_tril.shape[-2:] != (
        POSITION_DIM,
        POSITION_DIM,
    ):
        raise ValueError(
            "scale_tril must end "
            "in [3,3]."
        )

    return (
        scale_tril
        @
        scale_tril.transpose(
            -1,
            -2,
        )
    )


