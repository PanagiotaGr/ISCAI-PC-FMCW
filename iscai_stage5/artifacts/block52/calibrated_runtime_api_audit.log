    planar_error,
    validity,
):
    error = np.asarray(
        planar_error,
        dtype=np.float64,
    )

    mask = (
        np.asarray(
            validity
        )
        >
        0.5
    )

    if error.shape != mask.shape:
        raise ValueError(
            "Planar-error/mask "
            "shape mismatch."
        )

    if not np.any(
        mask
    ):
        raise ValueError(
            "No valid planar errors."
        )

    horizon_names = (
        "0.1",
        "0.3",
        "0.5",
        "1.0",
    )

    return {
        "planar_ADE_m":
            float(
                np.mean(
                    error[
                        mask
                    ]
                )
            ),

        "horizon_planar_error_m": {
            name:
                float(
                    np.mean(
                        error[
                            mask[
                                :,
                                horizon
                            ],
                            horizon
                        ]
                    )
                )
            for horizon, name
            in enumerate(
                horizon_names
            )
        },
    }


------------------------------------------------------------
prediction_sha256 (mean, scale_tril)
------------------------------------------------------------
def prediction_sha256(
    mean,
    scale_tril,
):
    digest = sha256()

    for tensor in (
        mean,
        scale_tril,
    ):
        value = (
            tensor.detach()
            .cpu()
            .contiguous()
            .numpy()
            .astype(
                np.float32,
                copy=False,
            )
        )

        digest.update(
            value.tobytes(
                order="C"
            )
        )

    return digest.hexdigest()


