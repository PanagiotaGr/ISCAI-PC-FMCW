0269: def eligible_formal_targets(
0270:     scenario,
0271: ):
0272:     """
0273:     Must be called only after prediction generation.
0274: 
0275:     Returns target-level evaluator metadata and
0276:     future-validity at the four frozen horizons.
0277:     """
0278: 
0279:     indices = tracks_to_predict_indices(
0280:         scenario
0281:     )
0282: 
0283:     current_index = int(
0284:         scenario.current_time_index
0285:     )
0286: 
0287:     if current_index != 10:
0288:         raise RuntimeError(
0289:             "Frozen WOMD current_time_index "
0290:             f"changed: {current_index}"
0291:         )
0292: 
0293:     classes = []
0294:     validity = []
0295: 
0296:     for index in indices:
0297:         track = scenario.tracks[
0298:             index
0299:         ]
0300: 
0301:         classes.append(
0302:             int(
0303:                 track.object_type
0304:             )
0305:         )
0306: 
0307:         row = []
0308: 
0309:         for offset in (
0310:             HORIZON_FRAME_OFFSETS
0311:         ):
0312:             state_index = (
0313:                 current_index
0314:                 +
0315:                 offset
0316:             )
0317: 
0318:             valid = (
0319:                 state_index
0320:                 <
0321:                 len(
0322:                     track.states
0323:                 )
0324:                 and
0325:                 bool(
0326:                     track.states[
0327:                         state_index
0328:                     ].valid
0329:                 )
0330:             )
0331: 
0332:             row.append(
0333:                 bool(
0334:                     valid
0335:                 )
0336:             )
0337: 
0338:         validity.append(
0339:             row
0340:         )
0341: 
0342:     return {
0343:         "track_index":
0344:             np.asarray(
0345:                 indices,
0346:                 dtype=np.int64,
0347:             ),
0348: 
0349:         "class_id":
0350:             np.asarray(
0351:                 classes,
0352:                 dtype=np.int64,
0353:             ),
0354: 
0355:         "validity":
0356:             np.asarray(
0357:                 validity,
0358:                 dtype=np.bool_,
0359:             ).reshape(
0360:                 len(
0361:                     indices
0362:                 ),
0363:                 4,
0364:             ),
0365:     }

