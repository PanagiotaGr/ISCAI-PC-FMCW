# ============================================================
# Module 3 - TODO Cell 1I
# Final staged top-down construction with:
# - consistent colors across all panels
# - clearer Δθ visibility
# - label boxes instead of many arrows
# Uses existing Module 3 variables only.
# ============================================================

demo_theta_c_deg = -28.0
demo_delta_theta_deg = 0.3

demo_target_range_m = 45.0
demo_target_width_m = 1.9
demo_lateral_safety_margin_m = 1.0
demo_epsilon_deg = np.rad2deg(np.arctan((demo_target_width_m / 2 + demo_lateral_safety_margin_m) / demo_target_range_m))

# Shadow-zone angular boundaries [degrees]
demo_shadow_center_deg = demo_theta_c_deg - demo_delta_theta_deg

demo_theta_shadow_min_deg = demo_shadow_center_deg - demo_epsilon_deg
demo_theta_shadow_max_deg = demo_shadow_center_deg + demo_epsilon_deg

# ------------------------------------------------------------
# Plotting-only geometry
