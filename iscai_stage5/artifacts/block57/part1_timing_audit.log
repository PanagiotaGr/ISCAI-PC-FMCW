# ============================================================
# Module 3 - TODO Cell 1O shared helpers
# Consolidated helpers for the clean final Fig. 3 / ADB-style plots
# ============================================================

# ------------------------------------------------------------
# Helper: extract dynamic shadow-angle series from one GT track
# ------------------------------------------------------------
def adb_fig3_clean_track_series_from_gt(x_track, y_track):
    """
    Return frame-wise dynamic shadow-angle quantities for one GT track.
    """
    adb_fig3_clean_frames = np.arange(len(x_track))

    adb_fig3_clean_geom = adb_trz_shadow_geometry_from_xy(
        x_track,
        y_track
    )

    return {
        "frames": adb_fig3_clean_frames,
        "theta_c": adb_fig3_clean_geom["theta_c"],
        "shadow_center": adb_fig3_clean_geom["shadow_center"],
        "theta_min": adb_fig3_clean_geom["theta_min"],
        "theta_max": adb_fig3_clean_geom["theta_max"],
        "epsilon": adb_fig3_clean_geom["epsilon"],
    }


# ------------------------------------------------------------
# Helper: extract dynamic shadow-angle series from one track
# ------------------------------------------------------------
def adb_fig3_clean_track_series(track):
    """
    Return frame-wise dynamic shadow-angle quantities for one reconstructed track.
    """
    adb_fig3_clean_frames, adb_fig3_clean_x, adb_fig3_clean_y = adb_trz_track_arrays(track)

    adb_fig3_clean_geom = adb_trz_shadow_geometry_from_xy(
        adb_fig3_clean_x,
        adb_fig3_clean_y
    )

    return {
        "frames": adb_fig3_clean_frames,
        "theta_c": adb_fig3_clean_geom["theta_c"],
        "shadow_center": adb_fig3_clean_geom["shadow_center"],
        "theta_min": adb_fig3_clean_geom["theta_min"],
        "theta_max": adb_fig3_clean_geom["theta_max"],
        "epsilon": adb_fig3_clean_geom["epsilon"],
    }


def adb_fig3_clean_add_line_key(ax, x0, x1, y, color, linestyle, text, text_color=None):
    """
    Add a line sample and label in empty white space.
    This replaces legends/arrows and keeps annotations away from the curves.
    """
    if text_color is None:
        text_color = color

    ax.plot(
        [x0, x1],
        [y, y],
        color=color,
        linestyle=linestyle,
        linewidth=2.0,
        clip_on=False
    )

    ax.text(
        x1 + 1.2,
        y,
        text,
        ha="left",
        va="center",
        fontsize=8,
        color=text_color,
        bbox=dict(
            boxstyle="round,pad=0.18",
            facecolor="white",
            edgecolor="none",
            alpha=0.92
        )
    )


def adb_fig3_clean_add_window_key(ax, x0, x1, y, color, text):
    """
    Add a compact sample for a shadow window Θ(t) in the white area.
    """
    ax.hlines(
        y,
        x0,
        x1,
        color=color,
        linewidth=7.0,
        alpha=0.25,
        clip_on=False
    )

    ax.plot(
        [x0, x0],
        [y - 0.45, y + 0.45],
        color=color,
        linewidth=1.5,
        clip_on=False
    )

    ax.plot(
        [x1, x1],
        [y - 0.45, y + 0.45],
        color=color,
        linewidth=1.5,
        clip_on=False
    )

    ax.text(
        x1 + 1.2,
        y,
        text,
        ha="left",
        va="center",
        fontsize=8,
        color=color,
        bbox=dict(
            boxstyle="round,pad=0.18",
            facecolor="white",
            edgecolor="none",
            alpha=0.92
        )
    )



def adb_fig3_clean_layout(track1, track2):
    """
    Compute shared axis limits and explanation-strip coordinates.
    """
    all_theta = np.concatenate([
        track1["theta_min"],
        track1["theta_max"],
        track1["shadow_center"],
        track2["theta_min"],
        track2["theta_max"],
        track2["shadow_center"],
    ])

    data_ymin = np.floor(all_theta.min() - 2.0)
    data_ymax = np.ceil(all_theta.max() + 2.0)
    key_space = 14.0

    xmin = min(track1["frames"].min(), track2["frames"].min())
    xmax = max(track1["frames"].max(), track2["frames"].max())

    return {
        "all_theta": all_theta,
        "data_ymin": data_ymin,
        "data_ymax": data_ymax,
        "key_space": key_space,
        "ymin": data_ymin - key_space,
        "ymax": data_ymax,
        "xmin": xmin,
        "xmax": xmax,
        "xlim_left": xmin,
        "xlim_right": xmax + 6.0,
        "key_y1": data_ymin - key_space + 3.0,
        "key_y2": data_ymin - key_space + 6.0,
        "key_y3": data_ymin - key_space + 9.0,
        "key_x0": xmin + 2.0,
        "key_x1": xmin + 9.0,
    }


def adb_fig3_clean_style_axis(ax, layout):
    ax.set_xlim(layout["xlim_left"], layout["xlim_right"])
    ax.set_ylim(layout["ymin"], layout["ymax"])
    ax.grid(False)

    for spine in ax.spines.values():
        spine.set_linewidth(0.8)


