# ============================================================
# Module 3 - TODO Cell 1J
# Dynamic shadow interval from Module 2 reconstructed tracks
# ============================================================

# ------------------------------------------------------------
# Helper: convert one reconstructed track to ordered arrays
# ------------------------------------------------------------
def adb_track_arrays(track):
    """
    Convert one reconstructed Module 2 track into ordered frame, x, y arrays.
    """
    points_by_frame = m2_track_points_by_frame(track)
    frames = np.array(sorted(points_by_frame.keys()))
    xy = np.array([points_by_frame[frame] for frame in frames])

    return frames, xy[:, 0], xy[:, 1]


def adb_shadow_geometry_from_xy(x_track, y_track, include_radial_zone=False):
    """
    Convert reconstructed x(t), y(t) into dynamic ADB shadow geometry.

    Coordinate convention:
        ego vehicle at (0, 0)
        +y = forward
        +x = right
        theta = atan2(x, y), in degrees

    Dynamic quantities:
        r(t)
        theta_c(t)
        theta_center(t) = theta_c(t) - Delta theta
        epsilon(t)
        theta_min(t)
        theta_max(t)
    """
    target_range = np.sqrt(x_track**2 + y_track**2)
    theta_c = np.rad2deg(np.arctan2(x_track, y_track))
    shadow_center = theta_c - delta_theta_deg
    effective_half_width = target_width_m / 2.0 + lateral_safety_margin_m
    epsilon = np.rad2deg(np.arctan(effective_half_width / np.maximum(target_range, EPS)))

    geometry = {
        "range": target_range,
        "range_target": target_range,
        "theta_c": theta_c,
        "shadow_center": shadow_center,
        "epsilon": epsilon,
        "theta_min": shadow_center - epsilon,
        "theta_max": shadow_center + epsilon,
    }

    if include_radial_zone:
        geometry["r_min"] = target_range + adb_trz_front_margin_units
        geometry["r_max"] = geometry["r_min"] + adb_trz_transition_length_units

    return geometry


def adb_select_snapshot_indices(frames, n_samples=5):
    """
    Select representative indices from the frames that actually exist
    in the reconstructed track.
    """
    if len(frames) == 0:
        return np.array([])

    sample_positions = np.linspace(0, len(frames) - 1, min(n_samples, len(frames)))
    return np.array(sorted(set(int(round(position)) for position in sample_positions)))


def adb_rec_track_arrays(track):
    return adb_track_arrays(track)


def adb_rec_shadow_geometry_from_xy(x_track, y_track):
    return adb_shadow_geometry_from_xy(x_track, y_track)


def adb_rec_select_frame_indices(frames, n_samples=5):
    return adb_select_snapshot_indices(frames, n_samples)


# ------------------------------------------------------------
# Helper: draw one dynamic shadow cone
# ------------------------------------------------------------
def adb_rec_add_shadow_cone(
    ax,
    theta_min_deg,
    theta_max_deg,
    cone_length,
    alpha_value=0.13
):
    """
    Draw one reconstructed-track-driven angular shadow cone.
    """
    cone_min_x, cone_min_y = ray_xy_from_yaxis(theta_min_deg, cone_length)
    cone_max_x, cone_max_y = ray_xy_from_yaxis(theta_max_deg, cone_length)

    ax.add_patch(
        Polygon(
            [(0.0, 0.0), (cone_min_x, cone_min_y), (cone_max_x, cone_max_y)],
            closed=True,
            color=COLOR_THETA_BOUNDS,
            alpha=alpha_value
        )
    )

    ax.plot(
        [0.0, cone_min_x],
        [0.0, cone_min_y],
        linestyle=":",
        linewidth=1.2,
        color=COLOR_THETA_BOUNDS,
        alpha=0.9
    )

    ax.plot(
        [0.0, cone_max_x],
        [0.0, cone_max_y],
        linestyle=":",
        linewidth=1.2,
        color=COLOR_THETA_BOUNDS,
        alpha=0.9
    )


# ------------------------------------------------------------
# Helper: plot one reconstructed track with dynamic shadow intervals
# ------------------------------------------------------------
def adb_rec_add_track_panel(ax, track, track_index, track_color):
    """
    Draw one reconstructed Module 2 track and its dynamic shadow intervals.
    """
    frames, x_track, y_track = adb_rec_track_arrays(track)
    rec_geom = adb_rec_shadow_geometry_from_xy(x_track, y_track)
    selected_indices = adb_rec_select_frame_indices(frames, n_samples=5)

    # Forward axis and ego vehicle
    ax.plot(
        [0.0, 0.0],
        [0.0, m2_y_range[1]],
        linestyle="--",
        linewidth=1.0,
        color=COLOR_FORWARD,
        alpha=0.75
    )

    add_ego_vehicle(ax)

    # Reconstructed trajectory
    ax.plot(
        x_track,
