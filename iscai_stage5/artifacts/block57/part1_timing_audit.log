import numpy as np
import matplotlib.pyplot as plt

RNG_SEED = 58767 + 58523
rng = np.random.default_rng(RNG_SEED)

c = 299_792_458.0  # speed of light [m/s]

# -----------------------------
# Paper reference parameters
# -----------------------------
fc = 193.4e12       # optical carrier frequency [Hz]
B = 10e9            # chirp bandwidth [Hz]
T_chirp = 10e-6     # chirp duration / period [s]
data_rate = 1e9     # reference data rate [bit/s]

S = B / T_chirp     # chirp slope [Hz/s]
lambda_c = c / fc   # carrier wavelength [m]

Rs = data_rate      # symbol rate [symbols/s]
Ts = 1.0 / Rs       # symbol duration [s]

# x[m, n]
SLOW_TIME_AXIS = 0 # m = chirp index / slow-time  -> axis 0
FAST_TIME_AXIS = 1 # n = fast-time sample index   -> axis 1

print(f"Chirp slope S = {S:.3e} Hz/s")
print(f"Carrier wavelength = {lambda_c:.3e} m")
print(f"Symbol duration Ts = {Ts:.3e} s")

# -----------------------------
# Numerical safeguards and unit conversions
# -----------------------------
EPS = 1e-12

KMH_TO_MPS = 1000.0 / 3600.0
MPS_TO_KMH = 3600.0 / 1000.0

DEG_TO_RAD = np.pi / 180.0
RAD_TO_DEG = 180.0 / np.pi

CM_PER_M = 100.0
M_PER_CM = 0.01

# -----------------------------
# Paper-reported reference results
# -----------------------------
PAPER_REPORTED_RANGE_ERROR_CM = 3.8
PAPER_REPORTED_MHT_LINEAR_ERRORS_UNITS = (0.1251, 0.2348)
PAPER_REPORTED_MHT_MEAN_DEVIATION_UNITS = 1.6787

