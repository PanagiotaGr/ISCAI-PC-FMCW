demo_car_width_for_arcs_m = 1.9

# ------------------------------------------------------------
# Consistent color convention
# ------------------------------------------------------------
COLOR_THETA_C = "crimson"      # θc / target ray
COLOR_DELTA = "darkorange"         # Δθ
COLOR_CENTER = "forestgreen"   # θc - Δθ
COLOR_EPS = "crimson"       # ε
COLOR_THETA_BOUNDS = "dodgerblue"   # θmin, θmax, Θ
COLOR_FORWARD = "0.55"         # forward axis

def ray_xy_from_yaxis(angle_deg, length_m):
    """
    Convert an angle measured from the forward y-axis to x-y coordinates.
    θ = 0°  -> straight ahead.
    θ < 0° -> left.
    θ > 0° -> right.
    """
    angle_rad = np.deg2rad(angle_deg)
    return length_m * np.sin(angle_rad), length_m * np.cos(angle_rad)

def add_angle_arc(ax, angle_start_deg, angle_end_deg, radius_m, label, color, lw=3.0):
    """
    Draw an angle arc.
    Our ADB angle θ is measured from the forward y-axis.
    Matplotlib Arc angles are measured from the positive x-axis.
    """
    theta_low = min(angle_start_deg, angle_end_deg)
    theta_high = max(angle_start_deg, angle_end_deg)

    mpl_theta1 = 90.0 - theta_high
    mpl_theta2 = 90.0 - theta_low

    arc = Arc(
        (0.0, 0.0),
        width=2.0 * radius_m,
        height=2.0 * radius_m,
        angle=0.0,
        theta1=mpl_theta1,
        theta2=mpl_theta2,
        linewidth=lw,
        color=color
    )
    ax.add_patch(arc)

    mid_angle_deg = 0.5 * (angle_start_deg + angle_end_deg)
    label_x, label_y = ray_xy_from_yaxis(mid_angle_deg, radius_m + 3.0)

    ax.text(
        label_x,
        label_y,
        label,
        color=color,
        fontsize=11,
        fontweight="bold",
        ha="center",
        va="center"
    )

def add_label_box(ax, text):
    """
    Add a clean explanation box inside the panel.
    """
    ax.text(
        0.04,
        0.96,
        text,
        transform=ax.transAxes,
        ha="left",
        va="top",
        fontsize=9,
        bbox=dict(
            boxstyle="round,pad=0.35",
            facecolor="white",
            edgecolor="0.75",
            alpha=0.95
        )
    )

def add_line_label(ax, x, y, text, color="black", ha="left"):
    """
    Direct label near a line, without arrow.
    """
    ax.text(
        x,
        y,
        text,
        fontsize=9,
        color=color,
        ha=ha,
        va="center",
        bbox=dict(
            boxstyle="round,pad=0.15",
            facecolor="white",
            edgecolor="none",
            alpha=0.88
        )
    )

def add_ego_vehicle(ax):
    ax.add_patch(
        Rectangle(
            (-demo_car_width_for_arcs_m / 2, -demo_car_length_for_arcs_m / 2),
            demo_car_width_for_arcs_m,
            demo_car_length_for_arcs_m,
            fill=False,
            linewidth=1.4
        )
    )
    ax.text(0, -4.0, "ego", ha="center", va="top", fontsize=8)

def add_target_vehicle(ax, target_x, target_y, alpha=1.0):
    ax.add_patch(
        Rectangle(
            (
                target_x - demo_car_width_for_arcs_m / 2,
                target_y - demo_car_length_for_arcs_m / 2
            ),
            demo_car_width_for_arcs_m,
            demo_car_length_for_arcs_m,
            fill=False,
            linewidth=1.3,
            alpha=alpha
        )
    )
    ax.text(
        target_x,
        target_y + 4.5,
        "target",
        ha="center",
        va="bottom",
        fontsize=8,
        alpha=alpha
    )

def base_panel_format(ax):
    # Forward reference axis
    ax.plot(
        [0, 0],
        [0, demo_plot_range_for_arcs_m],
        linestyle="--",
        linewidth=1.0,
        color=COLOR_FORWARD,
        alpha=0.75
    )

    add_ego_vehicle(ax)

    ax.set_aspect("equal", adjustable="box")
    ax.grid(False)
    ax.set_xticks([])
    ax.set_yticks([])

    for spine in ax.spines.values():
        spine.set_line

