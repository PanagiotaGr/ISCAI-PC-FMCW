# ============================================================
# Module 3 - TODO Cell 1M (educational version)
# Dynamic angle mapping:
# top-down geometry  ->  1D shadow-angle axis
# ============================================================

if len(m2_final_tracks) == 0:
    raise ValueError("m2_final_tracks is empty. Run Module 2 first.")


# ------------------------------------------------------------
# Small plotting helpers
# ------------------------------------------------------------
adb_angmap_num_snapshots = globals().get("adb_trz_num_snapshots", 4)
adb_angmap_track_colors = ["tab:blue", "tab:orange", "tab:green", "tab:red"]


def adb_angmap_add_arc(ax, angle_start_deg, angle_end_deg, radius_value, label_text, color_value, lw=2.2):
    """
    Draw an angle arc using the Module 3 convention:
    angle measured from the forward +y axis.
    """
    adb_angmap_low = min(angle_start_deg, angle_end_deg)
    adb_angmap_high = max(angle_start_deg, angle_end_deg)

    adb_angmap_theta1 = 90.0 - adb_angmap_high
    adb_angmap_theta2 = 90.0 - adb_angmap_low

    adb_angmap_arc = Arc(
        (0.0, 0.0),
        width=2.0 * radius_value,
        height=2.0 * radius_value,
        angle=0.0,
        theta1=adb_angmap_theta1,
        theta2=adb_angmap_theta2,
        linewidth=lw,
        color=color_value
    )
    ax.add_patch(adb_angmap_arc)

    adb_angmap_mid_angle = 0.5 * (angle_start_deg + angle_end_deg)
    adb_angmap_label_x, adb_angmap_label_y = ray_xy_from_yaxis(
        adb_angmap_mid_angle,
        radius_value + 2.0
    )

    ax.text(
        adb_angmap_label_x,
        adb_angmap_label_y,
        label_text,
        color=color_value,
        fontsize=9,
        fontweight="bold",
        ha="center",
        va="center"
    )


def adb_angmap_topdown_panel_format(ax):
    """
    Minimal top-down format consistent with the Module 3 reference style.
    """
    ax.plot(
        [0.0, 0.0],
        [0.0, m2_y_range[1] + 8.0],
        linestyle="--",
        linewidth=1.0,
        color=COLOR_FORWARD,
        alpha=0.75
    )

    add_ego_vehicle(ax)

    ax.set_aspect("equal", adjustable="box")
    ax.grid(False)
    ax.set_xticks([])
    ax.set_yticks([])

    for adb_angmap_spine in ax.spines.values():
        adb_angmap_spine.set_linewidth(0.8)


def adb_angmap_draw_topdown(ax, frames, x_track, y_track, geom, array_idx, track_color, track_label):
    """
    Left panel: top-down geometry for one selected snapshot.
    """
    adb_angmap_topdown_panel_format(ax)

    adb_angmap_frame = frames[array_idx]
    adb_angmap_x = x_track[array_idx]
    adb_angmap_y = y_track[array_idx]

    adb_angmap_theta_c = geom["theta_c"][array_idx]
    adb_angmap_center = geom["shadow_center"][array_idx]
    adb_angmap_theta_min = geom["theta_min"][array_idx]
    adb_angmap_theta_max = geom["theta_max"][array_idx]
    adb_angmap_range = geom["range_target"][array_idx]
    adb_angmap_r_max = geom["r_max"][array_idx]
    adb_angmap_epsilon = geom["epsilon"][array_idx]

    # Trajectory: past solid, future faded dashed
    ax.plot(
        x_track[array_idx:],
        y_track[array_idx:],
        linestyle="--",
        linewidth=1.2,
        color=track_color,
        alpha=0.35
    )

    ax.plot(
        x_track[:array_idx + 1],
        y_track[:array_idx + 1],
        linewidth=2.2,
        color=track_color,
        alpha=0.95
    )

    # Shadow cone Θ(t), drawn up to r_max
    adb_angmap_theta_min_x, adb_angmap_theta_min_y = ray_xy_from_yaxis(
        adb_angmap_theta_min,
        adb_angmap_r_max
    )
    adb_angmap_theta_max_x, adb_angmap_theta_max_y = ray_xy_from_yaxis(
        adb_angmap_theta_max,
        adb_angmap_r_max
    )

    ax.add_patch(
        Polygon(
            [(0.0, 0.0),
             (adb_angmap_theta_min_x, adb_angmap_theta_min_y),
             (adb_angmap_theta_max_x, adb_angmap_theta_max_y)],
            closed=True,
            color=COLOR_THETA_BOUNDS,
            alpha=0.12
        )
    )

    # Boundary rays
    ax.plot(
        [0.0, adb_angmap_theta_min_x],
        [0.0, adb_angmap_theta_min_y],
        linestyle=":",
        linewidth=1.5,
        color=COLOR_THETA_BOUNDS
    )

    ax.plot(
        [0.0, adb_angmap_theta_max_x],
        [0.0, adb_angmap_theta_max_y],
        linestyle=":",
        linewidth=1.5,
