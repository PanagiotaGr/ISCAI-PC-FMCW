# ============================================================
# Presentation-only plots - PC-FMCW waveform intuition
# Uses existing Module 0 variables only.
# ============================================================

from matplotlib.patches import Polygon, Rectangle, Arc

pcfmw_plot_sample_count = 1000
pcfmw_plot_time_s = np.linspace(0.0, T_chirp, pcfmw_plot_sample_count)
pcfmw_frequency_offset_hz = S * pcfmw_plot_time_s
pcfmw_phase_cycles = (np.pi * S * pcfmw_plot_time_s**2) / (2.0 * np.pi)

# -----------------------------
# Plot 1: Chirp frequency ramp
# -----------------------------
pcfmw_freq_fig, pcfmw_freq_ax = plt.subplots(figsize=(9, 5))

pcfmw_freq_ax.plot(
    pcfmw_plot_time_s * 1e6,
    pcfmw_frequency_offset_hz / 1e9,
    linewidth=2
)

pcfmw_freq_ax.set_title("Module 0: Linear FMCW chirp frequency ramp")
pcfmw_freq_ax.set_xlabel("Fast-time within one chirp, t [μs]")
pcfmw_freq_ax.set_ylabel("Baseband frequency offset, f_offset(t) [GHz]")

pcfmw_freq_formula_text = (
    "Formula:\n"
    r"$S = B/T_{\mathrm{chirp}}$" "\n"
    r"$f_{\mathrm{offset}}(t)=S t$" "\n\n"
    "Units:\n"
    r"$B$ [Hz], $T_{\mathrm{chirp}}$ [s]" "\n"
    r"$S$ [Hz/s], $f$ [Hz]"
)

pcfmw_freq_parameter_text = (
    "We do not plot fc + St.\n\n"
    "Expected endpoint:\n"
    "f_offset(T_chirp) = B"
)

add_info_box(pcfmw_freq_ax, pcfmw_freq_formula_text, loc="upper left")
add_info_box(pcfmw_freq_ax, pcfmw_freq_parameter_text, loc="lower right")

pcfmw_freq_ax.scatter([T_chirp * 1e6], [B / 1e9], s=60)
pcfmw_freq_ax.annotate(
    "End of chirp:\n10 GHz sweep completed",
    xy=(T_chirp * 1e6, B / 1e9),
    xytext=(T_chirp * 1e6 * 0.55, B / 1e9 * 0.78),
    arrowprops=dict(arrowstyle="->"),
    fontsize=9,
)

pcfmw_freq_fig.text(
    0.5, 0.01,
    "Caption: The chirp slope S is the rate at which the FMCW frequency changes.",
    ha="center",
    fontsize=9,
)

plt.tight_layout(rect=[0, 0.06, 1, 1])
plt.show()

# -----------------------------
# Plot 2: Baseband phase growth
# -----------------------------
pcfmw_phase_fig, pcfmw_phase_ax = plt.subplots(figsize=(9, 5))

pcfmw_phase_ax.plot(
    pcfmw_plot_time_s * 1e6,
    pcfmw_phase_cycles / 1e3,
    linewidth=2
)

pcfmw_phase_ax.set_title("Module 0: Quadratic baseband phase growth")
pcfmw_phase_ax.set_xlabel("Fast-time within one chirp, t [μs]")
pcfmw_phase_ax.set_ylabel("Baseband phase [thousand cycles]")

pcfmw_phase_formula_text = (
    "Formula:\n"
    r"$\phi_{\mathrm{bb}}(t)=\pi S t^2$" "\n"
    r"$N_{\mathrm{cycles}}=\phi_{\mathrm{bb}}/(2\pi)$" "\n\n"
    "Meaning:\n"
    "linear frequency ramp\n"
    "comes from quadratic phase."
)

pcfmw_phase_axis_text = (
    "Axes:\n"
    "x-axis: fast-time inside one chirp\n"
    "y-axis: phase in cycles / 1000\n\n"
    "Why cycles?\n"
    "Radians become very large,\n"
    "so cycles are easier to read."
)

add_info_box(pcfmw_phase_ax, pcfmw_phase_formula_text, loc="upper left")
add_info_box(pcfmw_phase_ax, pcfmw_phase_axis_text, loc="lower right")

pcfmw_phase_fig.text(
    0.5, 0.01,
    "Caption: The FMCW chirp has quadratic phase, whose derivative gives a linear instantaneous frequency. "
    "This is why the previous plot is linear while this phase plot is curved.",
    ha="center",
    fontsize=9,
)

plt.tight_layout(rect=[0, 0.07, 1, 1])
plt.show()

