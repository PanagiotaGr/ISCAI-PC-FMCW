def adb_shadow_angles_deg(x_m, y_m):
    rho_m = np.hypot(x_m, y_m)
    epsilon_dyn_rad = np.arctan(lateral_safety_margin_m / rho_m)

    theta_center = np.arctan2(y_m, x_m)
    theta_min = np.arctan2(y_m - assumed_vehicle_half_width_m, x_m) - epsilon_dyn_rad
    theta_max = np.arctan2(y_m + assumed_vehicle_half_width_m, x_m) + epsilon_dyn_rad

    return np.rad2deg(theta_center), np.rad2deg(theta_min), np.rad2deg(theta_max)

