    center = xy.mean(axis=0)
    _, _, vh = np.linalg.svd(xy - center)

    normal = vh[-1]
    rho = float(normal[0] * center[0] + normal[1] * center[1])
    theta_deg = float(np.rad2deg(np.arctan2(normal[1], normal[0])))

    # Keep the same Hough convention as the accumulator:
