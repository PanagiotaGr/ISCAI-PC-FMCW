def m2_track_support_union(track):
    return set().union(*(segment["support_ids"] for segment in track["segments"]))


def m2_track_passes_final_filters(track):
    """
    This is NOT keep-top-2: every track either passes or fails fixed criteria.
    """
    points_by_frame = m2_track_points_by_frame(track)
    support_count = len(m2_track_support_union(track))
    coverage = len(points_by_frame) / m2_num_frames

    passes = (
        coverage >= m2_min_final_coverage
        and support_count >= m2_min_final_support
        and len(track["segments"]) >= m2_min_final_segments
    )

    return passes, {
        "coverage": coverage,
        "support_count": support_count,
        "num_segments": len(track["segments"]),
        "num_frames": len(points_by_frame),
    }

