    if theta_deg > 90.0:
        theta_deg -= 180.0
        rho = -rho

    if theta_deg < -90.0:
        theta_deg += 180.0
        rho = -rho

    validated_hough_rows.append({
        "track_id": track["track_id"],
        "rho": rho,
        "theta_deg": theta_deg,
        "support": len(frames),
