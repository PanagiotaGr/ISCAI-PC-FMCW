from __future__ import annotations

from pathlib import Path


from iscai_stage3.baselines.imm_report import (
    IMMReportRecord,
    select_mode,
    report_sha256,
)



from iscai_stage3.baselines.causal_state import (
    estimate_causal_motion_state,
)

from iscai_stage3.baselines.imm_real_step import (
    imm_real_step,
)


import json


from waymo_open_dataset.protos import scenario_pb2


from iscai_stage0.womd_proto_io import (
    read_first_scenario,
)

from iscai_stage1.actors.womd_adapter import (
    adapt_causal_womd_scenario,
)

from iscai_stage2.observations.womd_ideal_adapter import (
    build_real_ideal_observation_scene,
)

from iscai_stage3.baselines.imm_core import (
    IMMProbabilities,
    imm_mixing_probabilities,
    update_imm_probabilities,
)

from iscai_stage3.baselines.imm_likelihood import (
    normalized_likelihoods_from_logs,
)


SID = "b85e1bd6cc8e74c0"


MOTION = Path(
    "/home/agni/waymo/data/"
    "paired_womd_lidar_v1_3_0/"
    "validation/motion/"
    "paired-from-validation.tfrecord-00000-of-00150"
)


TRANSITION = (
    (0.90,0.05,0.05),
    (0.05,0.90,0.05),
    (0.05,0.05,0.90),
)


scenario = read_first_scenario(
    MOTION
)


if scenario.scenario_id != SID:
    raise RuntimeError(
        "Unexpected scenario."
    )


adapted = adapt_causal_womd_scenario(
    scenario
)


scene = build_real_ideal_observation_scene(
    raw_scenario=scenario,
    adapted=adapted,
    include_sdc=False,
)


mode_history = []

records = []


for actor in scene.actors:

    probabilities = IMMProbabilities(
        cv=0.34,
        ca=0.33,
        ctrv=0.33,
    )


    for obs in actor.observations:


        if not obs.geometry_valid:
            continue


        mixing = (
            imm_mixing_probabilities(
                probabilities=probabilities,
                transition_matrix=TRANSITION,
            )
        )


        causal_observations = (
            actor.observations[
                :obs.time_index + 1
            ]
        )


        positions = tuple(
            item.actor_position_Ht_m
            for item in causal_observations
            if item.geometry_valid
        )


        timestamps = tuple(
            item.timestamp_s
            for item in causal_observations
            if item.geometry_valid
        )


        if len(positions) < 3:
            continue


        motion_state = (
            estimate_causal_motion_state(
                positions=positions,
                timestamps=timestamps,
            )
        )



        predicted = (
            mixing
            .predicted_probabilities
        )


        #
        # Placeholder likelihoods:
        #
        # Next step will replace this
        # with CV/CA/CTRV innovations.
        #

        result = imm_real_step(
            probabilities=predicted,

            position=motion_state.position,

            velocity=motion_state.velocity,

            acceleration=motion_state.acceleration,

            heading_rad=motion_state.heading_rad,

            yaw_rate_radps=(
                motion_state.yaw_rate_radps
            ),

            measurement=measurement,

            covariance=covariance,

            dt=dt,
        )


        probabilities = (
            result.probabilities
        )



        mode_history.append(
            {
                "track_index":
                    actor.track_index,

                "time_index":
                    obs.time_index,

                "cv":
                    probabilities.cv,

                "ca":
                    probabilities.ca,

                "ctrv":
                    probabilities.ctrv,
            }
        )


report = {
    "scenario_id": SID,
    "actors": len(scene.actors),
    "mode_updates": len(mode_history),
    "future_used": False,
    "measured_fmcw": False,
    "status": "PASS",
}


Path(
    "reports"
).mkdir(
    exist_ok=True
)


Path(
    "reports/block3e4_imm_real_smoke.json"
).write_text(
    json.dumps(
        report,
        indent=2,
    )
)


print(
    "===== Stage3 IMM real smoke ====="
)

print(
    "scenario =",
    SID,
)

print(
    "actors =",
    len(scene.actors),
)

print(
    "IMM updates =",
    len(mode_history),
)

print(
    "future_used = NO"
)

print(
    "measured_fmcw = NO"
)

print(
    "IMM report SHA =",
    report_sha256(
        tuple(records)
    ),
)


print(
    "STATUS = PASS"
)
