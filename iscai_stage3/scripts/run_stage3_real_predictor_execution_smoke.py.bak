from __future__ import annotations

import json
from pathlib import Path


from iscai_stage0.womd_proto_io import (
    read_first_scenario,
)

from iscai_stage1.actors.womd_adapter import (
    adapt_causal_womd_scenario,
)

from iscai_stage2.observations.womd_ideal_adapter import (
    build_real_ideal_observation_scene,
)


from iscai_stage3.baselines.causal_state import (
    estimate_causal_motion_state,
)

from iscai_stage3.baselines.constant_velocity import (
    predict_constant_velocity,
)

from iscai_stage3.baselines.constant_acceleration import (
    predict_constant_acceleration,
)

from iscai_stage3.baselines.ctrv import (
    predict_ctrv,
)

from iscai_stage3.baselines.kalman import (
    predict_kalman_cv,
)

from iscai_stage3.baselines.imm import (
    select_imm_model,
)

from iscai_stage3.baselines.mht_adapter import (
    TrajectoryHypothesis,
    select_best_hypothesis,
)

from iscai_stage3.baselines.registry import (
    register_prediction,
)


SID = "b85e1bd6cc8e74c0"


MOTION = Path(
    "/home/agni/waymo/data/"
    "paired_womd_lidar_v1_3_0/"
    "validation/motion/"
    "paired-from-validation.tfrecord-00000-of-00150"
)


REPORT = Path(
    "reports/block3i_real_predictor_execution_smoke.json"
)


ARTIFACT = Path(
    "artifacts/real_predictor_trajectories.json"
)


HORIZON = 1.0
DT = 0.1



def map_actor_type(track):

    try:
        value = int(track.object_type)

    except Exception:
        return "UNKNOWN"


    if value == 1:
        return "VEHICLE"

    if value == 2:
        return "PEDESTRIAN"

    if value == 3:
        return "CYCLIST"

    return "UNKNOWN"



scenario = read_first_scenario(
    MOTION
)


actor_type_map = {}

for idx, track in enumerate(
    scenario.tracks
):
    actor_type_map[idx] = map_actor_type(track)



adapted = adapt_causal_womd_scenario(
    scenario
)


scene = build_real_ideal_observation_scene(
    raw_scenario=scenario,
    adapted=adapted,
    include_sdc=False,
)



models = {
    "CV":0,
    "CA":0,
    "CTRV":0,
    "KALMAN":0,
    "IMM":0,
    "MHT":0,
}


artifact = []

actor_count = 0
registered = 0



for actor in scene.actors:


    positions = []
    timestamps = []


    for obs in actor.observations:

        if not obs.geometry_valid:
            continue


        positions.append(
            obs.actor_position_Ht_m
        )

        timestamps.append(
            obs.timestamp_s
        )


    if len(positions) < 3:
        continue



    state = estimate_causal_motion_state(
        positions=tuple(
            positions[-3:]
        ),
        timestamps=tuple(
            timestamps[-3:]
        ),
    )


    cv = predict_constant_velocity(
        position=state.position,
        velocity=state.velocity,
        horizon_s=HORIZON,
        dt=DT,
    )


    ca = predict_constant_acceleration(
        position=state.position,
        velocity=state.velocity,
        acceleration=state.acceleration,
        horizon_s=HORIZON,
        dt=DT,
    )


    ctrv = predict_ctrv(
        position=state.position,
        speed=(
            state.velocity[0] ** 2
            +
            state.velocity[1] ** 2
        ) ** 0.5,
        heading_rad=state.heading_rad,
        yaw_rate=state.yaw_rate_radps,
        horizon_s=HORIZON,
        dt=DT,
    )


    kalman = predict_kalman_cv(
        position=state.position,
        velocity=state.velocity,
        horizon_s=HORIZON,
        dt=DT,
    )



    acc_norm = (
        state.acceleration[0] ** 2
        +
        state.acceleration[1] ** 2
        +
        state.acceleration[2] ** 2
    ) ** 0.5


    imm_state = select_imm_model(

        velocity_score=(
            1.0 /
            (1.0 + acc_norm)
        ),

        acceleration_score=(
            acc_norm + 1e-6
        ),

        turn_rate_score=(
            abs(
                state.yaw_rate_radps
            )
            +
            1e-6
        ),
    )



    if imm_state.selected_model == "CV":
        imm = cv

    elif imm_state.selected_model == "CA":
        imm = ca

    else:
        imm = ctrv



    hypotheses = (

        TrajectoryHypothesis(
            trajectory=cv,
            score=1.0,
        ),

        TrajectoryHypothesis(
            trajectory=ca,
            score=1.0,
        ),

        TrajectoryHypothesis(
            trajectory=ctrv,
            score=1.0,
        ),

    )


    mht_result = select_best_hypothesis(
        hypotheses
    )


    mht = mht_result.trajectory



    outputs = {

        "CV":cv,
        "CA":ca,
        "CTRV":ctrv,
        "KALMAN":kalman,
        "IMM":imm,
        "MHT":mht,

    }



    for name,trajectory in outputs.items():


        prediction = register_prediction(
            model_name=name,
            states=trajectory,
        )


        if prediction.future_used:
            raise RuntimeError(
                "Future leakage"
            )


        models[name]+=1
        registered+=1



        artifact.append(

            {
                "scenario_id":SID,

                "track_index":
                    actor.track_index,

                "actor_type":
                    actor_type_map.get(
                        actor.track_index,
                        "UNKNOWN"
                    ),

                "model_name":
                    name,

                "trajectory":
                [
                    list(point)
                    for point in trajectory
                ],

                "imm_selected_model":
                    imm_state.selected_model,

                "imm_probabilities":
                    imm_state.model_probabilities,

                "causal_only":
                    True,

                "future_used":
                    False,
            }

        )


    actor_count+=1



ARTIFACT.parent.mkdir(
    exist_ok=True
)


ARTIFACT.write_text(
    json.dumps(
        artifact,
        indent=2,
        sort_keys=True,
    )
)



report = {

    "block":
        "stage3i_real_predictor_execution_smoke",

    "scenario_id":
        SID,

    "actors":
        actor_count,

    "registered":
        registered,

    "models":
        models,

    "imm_enabled":
        True,

    "future_used":
        False,

    "status":
        "PASS",

}


REPORT.parent.mkdir(
    exist_ok=True
)


REPORT.write_text(
    json.dumps(
        report,
        indent=2,
        sort_keys=True,
    )
)



print(
    "===== Stage3 Predictor Execution ====="
)

print(
    "actors =",
    actor_count
)

print(
    "registered =",
    registered
)

print(
    "models =",
    models
)

print(
    "future_used = NO"
)

print(
    "STATUS = PASS"
)
