from __future__ import annotations

import json
from pathlib import Path


from iscai_stage0.womd_proto_io import (
    read_first_scenario,
)

from iscai_stage1.actors.womd_adapter import (
    adapt_causal_womd_scenario,
)

from iscai_stage2.observations.womd_ideal_adapter import (
    build_real_ideal_observation_scene,
)


from iscai_stage3.baselines.causal_state import (
    estimate_causal_motion_state,
)


from iscai_stage3.baselines.constant_velocity import (
    predict_constant_velocity,
)

from iscai_stage3.baselines.constant_acceleration import (
    predict_constant_acceleration,
)

from iscai_stage3.baselines.ctrv import (
    predict_ctrv,
)

from iscai_stage3.baselines.kalman import (
    predict_kalman_cv,
)

from iscai_stage3.baselines.registry import (
    register_prediction,
)



SID = "b85e1bd6cc8e74c0"


MOTION = Path(
    "/home/agni/waymo/data/"
    "paired_womd_lidar_v1_3_0/"
    "validation/motion/"
    "paired-from-validation.tfrecord-00000-of-00150"
)


REPORT = Path(
    "reports/block3i_real_predictor_execution_smoke.json"
)


HORIZON = 1.0
DT = 0.1



scenario = read_first_scenario(
    MOTION
)

adapted = adapt_causal_womd_scenario(
    scenario
)

scene = (
    build_real_ideal_observation_scene(
        raw_scenario=scenario,
        adapted=adapted,
        include_sdc=False,
    )
)



models = {}

actor_count = 0
registered = 0



for actor in scene.actors:

    positions = []
    timestamps = []


    for obs in actor.observations:

        if not obs.geometry_valid:
            continue

        positions.append(
            (
                obs.actor_position_Ht_m
            )
        )

        timestamps.append(
            obs.timestamp_s
        )


    if len(positions) < 3:
        continue


    state = (
        estimate_causal_motion_state(
            positions=tuple(
                positions[-3:]
            ),
            timestamps=tuple(
                timestamps[-3:]
            ),
        )
    )


    cv = predict_constant_velocity(
        position=state.position,
        velocity=state.velocity,
        horizon_s=HORIZON,
        dt=DT,
    )


    ca = predict_constant_acceleration(
        position=state.position,
        velocity=state.velocity,
        acceleration=state.acceleration,
        horizon_s=HORIZON,
        dt=DT,
    )


    ctrv = predict_ctrv(
        position=state.position,
        speed=(
            (
                state.velocity[0] ** 2
                +
                state.velocity[1] ** 2
            )
            ** 0.5
        ),
        heading_rad=state.heading_rad,
        yaw_rate=state.yaw_rate_radps,
        horizon_s=HORIZON,
        dt=DT,
    )


    kalman = predict_kalman_cv(
        position=state.position,
        velocity=state.velocity,
        horizon_s=HORIZON,
        dt=DT,
    )


    outputs = {
        "CV": cv,
        "CA": ca,
        "CTRV": ctrv,
        "KALMAN": kalman,
    }


    for name, trajectory in outputs.items():

        prediction = register_prediction(
            model_name=name,
            states=trajectory,
        )


        if prediction.future_used:
            raise RuntimeError(
                "Future leakage."
            )


        models.setdefault(
            name,
            0,
        )

        models[name] += 1

        registered += 1


    actor_count += 1



report = {

    "block":
        "stage3i_real_predictor_execution_smoke",

    "scenario_id":
        SID,

    "actors":
        actor_count,

    "registered":
        registered,

    "models":
        models,

    "horizon_s":
        HORIZON,

    "dt":
        DT,

    "future_used":
        False,

    "status":
        "PASS",
}


REPORT.parent.mkdir(
    exist_ok=True
)

REPORT.write_text(
    json.dumps(
        report,
        indent=2,
        sort_keys=True,
    )
)


print(
    "===== Stage3 Predictor Execution smoke ====="
)

print(
    "scenario =",
    SID
)

print(
    "actors =",
    actor_count
)

print(
    "registered =",
    registered
)

print(
    "models =",
    models
)

print(
    "future_used = NO"
)

print(
    "STATUS = PASS"
)

print(
    "report =",
    REPORT
)
